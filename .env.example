# Copy to .env in the repo root (apps/api loads this file).

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=7d

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/naano?retryWrites=true&w=majority

# Local Redis (docker compose) or hosted Redis
REDIS_URL=redis://127.0.0.1:6379

# Used for website/profile fetch User-Agent
INGEST_USER_AGENT=NaanoBot/0.1 (assignment; contact via repo)

# Optional. AI enrichment. Ingestion still stores raw text without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Continue with Google (OpenID Connect).
# Create an OAuth 2.0 Web client in Google Cloud and add this redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

